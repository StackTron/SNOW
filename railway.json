{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "node server.mjs",
    "healthcheckPath": "/api/me",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "variables": {
    "DATA_DIR": "/app/data",
    "NODE_ENV": "production"
  },
  "volumes": [
    {
      "name": "data",
      "mountPath": "/app/data"
    }
  ]
}